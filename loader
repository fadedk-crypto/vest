local knifedata = {}
local toolregistry = {}

local function skinCfg()
    return shared.vest and shared.vest["Misc"] and shared.vest["Misc"]["Skin Changer"]
end

local function skinEnabled()
    local cfg = skinCfg()
    return cfg and cfg["Enabled"] == true
end

local function skinFor(toolName)
    local cfg = skinCfg()
    return cfg and cfg["weapons"] and cfg["weapons"][toolName]
end

local function clearmesh(tool, exclude)
    for _, v in ipairs(tool:GetChildren()) do
        if v:IsA("MeshPart") and v ~= exclude then v:Destroy() end
    end
end

local function applygun(tool, name)
    if not tool or not tool:IsA("Tool") then return end

    local orig = tool:FindFirstChildOfClass("MeshPart")
    if not orig then return end

    local skinmodules = ReplicatedStorage:FindFirstChild("SkinModules")
    if not skinmodules then return end

    local success, modules = pcall(require, skinmodules)
    if not success or type(modules) ~= "table" then return end

    local weaponData = modules[tool.Name]
    local info = weaponData and weaponData[name]
    if not info then return end

    local skinpart = info.TextureID
    if skinpart == nil then return end

    clearmesh(tool, orig)

    if typeof(skinpart) == "Instance" then
        local clone = skinpart:Clone()
        clone.Name = "CurrentSkin"
        clone.Parent = tool
        clone.CFrame = orig.CFrame

        local weld = Instance.new("Weld")
        weld.Part0 = clone
        weld.Part1 = orig
        if info.CFrame then
            weld.C0 = info.CFrame:Inverse()
        end
        weld.Parent = clone
        orig.Transparency = 1
    elseif typeof(skinpart) == "string" then
        orig.TextureID = skinpart
        orig.Transparency = 0
    else
        return
    end

    local handle = tool:FindFirstChild("Handle")
    if handle then
        local shoot = handle:FindFirstChild("ShootSound")
        local skinassets = ReplicatedStorage:FindFirstChild("SkinAssets")

        if shoot and skinassets then
            local gunsounds = skinassets:FindFirstChild("GunShootSounds")
            local sounds = gunsounds and gunsounds:FindFirstChild(tool.Name)
            local soundObject = sounds and sounds:FindFirstChild(name)
            if soundObject and soundObject:IsA("StringValue") then
                shoot.SoundId = soundObject.Value
            end
        end

        local particlefolder = skinassets and skinassets:FindFirstChild("GunHandleParticle")
        local particlesource = particlefolder and particlefolder:FindFirstChild(name)
        if particlesource then
            local emitter = particlesource:FindFirstChildOfClass("ParticleEmitter")
            if not emitter then
                for _, descendant in ipairs(particlesource:GetDescendants()) do
                    if descendant:IsA("ParticleEmitter") then
                        emitter = descendant
                        break
                    end
                end
            end

            if emitter then
                for _, existing in ipairs(handle:GetChildren()) do
                    if existing:IsA("ParticleEmitter") then
                        existing:Destroy()
                    end
                end
                local emitterClone = emitter:Clone()
                emitterClone.Parent = handle
                emitterClone.Enabled = true
            end
        end

        handle:SetAttribute("SkinName", name)
    end
end

local function cleanknife(tool)
    local data = knifedata[tool]
    if not data then return end
    if data.track then
        data.track:Stop()
        data.track:Destroy()
        data.track = nil
    end
    if data.welds then
        for _, w in ipairs(data.welds) do if w then w:Destroy() end end
    end
    if data.sounds then
        for _, s in ipairs(data.sounds) do if s and s.Parent then s:Destroy() end end
    end
    local mesh = tool:FindFirstChild("Default")
    if mesh then
        for _, v in ipairs(mesh:GetChildren()) do
            if v.Name == "Handle.R" or v:IsA("Model") or (v:IsA("BasePart") and v.Name ~= "Default") then
                v:Destroy()
            end
        end
        mesh.Transparency = 0
    end
    knifedata[tool] = nil
end

local function applyknife(char, tool, skin)
    local skincfg = knifeskins[skin]
    if not skincfg then return end
    local hum = char:FindFirstChild("Humanoid")
    local rhand = char:FindFirstChild("RightHand")
    if not hum or not rhand then return end
    cleanknife(tool)
    knifedata[tool] = {track = nil, welds = {}, sounds = {}}
    local data = knifedata[tool]
    local mesh = tool:FindFirstChild("Default")
    if not mesh then return end
    mesh.Transparency = 1
    local skinmodules = ReplicatedStorage:FindFirstChild("SkinModules")
    if not skinmodules then return end
    local knives = skinmodules:FindFirstChild("Knives")
    if not knives then return end
    local skinmodel = knives:FindFirstChild(skin)
    if not skinmodel then return end
    local clone = skinmodel:Clone()
    clone.Name = skin
    local handr = Instance.new("Part")
    handr.Name = "Handle.R"
    handr.Transparency = 1
    handr.CanCollide = false
    handr.Anchored = false
    handr.Size = Vector3.new(0.001, 0.001, 0.001)
    handr.Massless = true
    handr.Parent = mesh
    local m6d = Instance.new("Motor6D")
    m6d.Name = "Handle.R"
    m6d.Part0 = rhand
    m6d.Part1 = handr
    m6d.Parent = handr
    local offset = CFrame.new(skincfg.positionoffset) * CFrame.Angles(math.rad(skincfg.rotationoffset.X), math.rad(skincfg.rotationoffset.Y), math.rad(skincfg.rotationoffset.Z))
    if clone:IsA("Model") then
        if not clone.PrimaryPart then
            for _, c in ipairs(clone:GetChildren()) do
                if c:IsA("BasePart") then clone.PrimaryPart = c break end
            end
        end
        if clone.PrimaryPart then
            for _, p in ipairs(clone:GetDescendants()) do
                if p:IsA("BasePart") then
                    p.CanCollide = false
                    p.Massless = true
                    p.Anchored = false
                    local w = Instance.new("Weld")
                    w.Part0 = handr
                    w.Part1 = p
                    w.C0 = offset
                    w.C1 = p.CFrame:ToObjectSpace(clone.PrimaryPart.CFrame)
                    w.Parent = p
                    table.insert(data.welds, w)
                end
            end
        end
        clone.Parent = mesh
    elseif clone:IsA("BasePart") then
        clone.CanCollide = false
        clone.Massless = true
        clone.Anchored = false
        if clone:IsA("MeshPart") and skincfg.textureid then clone.TextureID = skincfg.textureid end
        if skincfg.particle then
            local skinassets = ReplicatedStorage:FindFirstChild("SkinAssets")
            if skinassets then
                local pf = skinassets:FindFirstChild("GunHandleParticle")
                if pf then
                    local ps = pf:FindFirstChild(skin)
                    if ps then
                        local pe = ps:FindFirstChild("ParticleEmitter")
                        if pe then pe:Clone().Parent = clone end
                    end
                end
            end
        end
        clone.Parent = mesh
        local w = Instance.new("Weld")
        w.Part0 = handr
        w.Part1 = clone
        w.C0 = offset
        w.Parent = clone
        table.insert(data.welds, w)
    end
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    if skincfg.animationid and skincfg.animationid ~= "" then
        local anim = Instance.new("Animation")
        anim.AnimationId = skincfg.animationid
        local track = animator:LoadAnimation(anim)
        track.Looped = false
        track:Play()
        data.track = track
        anim:Destroy()
        track.Ended:Once(function()
            if data.track == track then data.track = nil end
            track:Destroy()
        end)
    end
    if skincfg.soundid and skincfg.soundid ~= "" then
        local snd = Instance.new("Sound")
        snd.SoundId = skincfg.soundid
        snd.Parent = workspace
        snd:Play()
        table.insert(data.sounds, snd)
        snd.Ended:Connect(function() snd:Destroy() end)
    end
    tool:SetAttribute("CurrentKnifeSkin", skin)
end

local function setuptool(tool)
    if not tool:IsA("Tool") then return end
    if toolregistry[tool] then return end
    toolregistry[tool] = true
    tool.Equipped:Connect(function()
        if not skinEnabled() then return end
        local char = tool.Parent
        if char ~= LocalPlayer.Character then return end
        local skin = skinFor(tool.Name)
        if not skin or skin == "" then return end
        if tool.Name == "[Knife]" then
            applyknife(char, tool, skin)
        else
            applygun(tool, skin)
        end
    end)
    tool.Unequipped:Connect(function()
        if tool.Name == "[Knife]" then
            local data = knifedata[tool]
            if not data then return end
            if data.welds then for _, w in ipairs(data.welds) do if w then w:Destroy() end end end
            if data.sounds then for _, s in ipairs(data.sounds) do if s and s.Parent then s:Destroy() end end end
            local mesh = tool:FindFirstChild("Default")
            if mesh then
                for _, v in ipairs(mesh:GetChildren()) do
                    if v.Name == "Handle.R" or v:IsA("Model") or (v:IsA("MeshPart") and v.Name ~= "Default") then v:Destroy() end
                end
                mesh.Transparency = 0
            end
        end
    end)
    if tool.Parent == LocalPlayer.Character and skinEnabled() then
        local skin = skinFor(tool.Name)
        if skin and skin ~= "" then
            if tool.Name == "[Knife]" then
                task.spawn(applyknife, LocalPlayer.Character, tool, skin)
            else
                task.spawn(applygun, tool, skin)
            end
        end
    end
end

local function watchchar(char)
    if not char then return end
    for _, v in ipairs(char:GetChildren()) do
        if v:IsA("Tool") then setuptool(v) end
    end
    char.ChildAdded:Connect(function(v)
        if v:IsA("Tool") then setuptool(v) end
    end)
end

if LocalPlayer.Character then watchchar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(watchchar)

for _, tool in ipairs(LocalPlayer.Backpack:GetChildren()) do
    if tool:IsA("Tool") then setuptool(tool) end
end

LocalPlayer.Backpack.ChildAdded:Connect(function(v)
    if v:IsA("Tool") then setuptool(v) end
end)

local vest = (function()

    return function(options)
        options = options or {}
        local Players   = game:GetService("Players")
        local Input     = game:GetService("UserInputService")
        local Workspace = game:GetService("Workspace")
        local player    = Players.LocalPlayer
        assert(player, "vest generic aim adapter requires LocalPlayer")
        assert(type(getloadedmodules) == "function", "Loaded-module inspection unavailable")

        local CFG      = shared.vest or {}
        local SA       = CFG["Silent Aim"] or {}
        local CHECKS   = CFG.Checks or {}
        local TARGET   = CFG.Targeting or {}
        local HITLOC   = SA["Hit Location"] or {}
        local CLOSEST  = HITLOC["ClosestPoint"] or {}
        local PRED     = SA.Prediction or {}
        local FOVCFG   = SA.FOV or {}
        local FOVSIZE  = FOVCFG.Size or {}

        local function pick(a, b, fallback)
            if a ~= nil then return a end
            if b ~= nil then return b end
            return fallback
        end

        local function resolveKey(raw)
            if typeof(raw) == "EnumItem" then return raw end
            if type(raw) == "string" then
                local ok, code = pcall(function() return Enum.KeyCode[raw] end)
                if ok and code then return code end
            end
            return Enum.UserInputType.MouseButton2
        end

        local settings = {
            Enabled        = pick(SA.Enabled, options.Enabled, true) ~= false,
            Method         = pick(SA.Method, options.Method, "Always"),
            HoldKey        = pick(CFG.Keybinds and CFG.Keybinds["Silent Aim"], options.HoldKey, "C"),

            Hitchance      = math.clamp(tonumber(pick(SA.Hitchance, options.Hitchance, 100)) or 100, 0, 100),

            AimPart        = pick(HITLOC.Part, options.AimPart, "ClosestPart"),
            ClosestPoint   = pick(CLOSEST.Enabled, options.ClosestPoint, false) == true,
            ClosestMode    = pick(CLOSEST.Mode, options.ClosestMode, "Regular"),
            ClosestScale   = math.max(tonumber(pick(CLOSEST.Scale, options.ClosestScale, 1.25)) or 1.25, 1),

            Prediction     = pick(PRED.Enabled, options.Prediction, false) == true,
            PredictionVal  = PRED.Values or options.PredictionValues or { 0, 0, 0 },

            FOVEnabled     = pick(FOVCFG.Enabled, options.FOVEnabled, true) ~= false,
            FOVX           = tonumber(FOVSIZE.X or options.FOVX) or 3,
            FOVY           = tonumber(FOVSIZE.Y or options.FOVY) or 3,
            FOVUnit        = pick(options.FOVUnit, nil, "Percent"),   -- "Percent" | "Pixels"
            FOVScale       = tonumber(options.FOVScale) or 1,

            MaxDistance    = tonumber(pick(options.MaxDistance, nil, 5000)) or 5000,
            ScanInterval   = math.max(tonumber(options.ScanInterval) or 0, 0),

            TeamCheck      = pick(options.TeamCheck, nil, false) == true,
            WallCheck      = pick(CHECKS.WallCheck, options.WallCheck, true) == true,
            Visible        = pick(CHECKS.Visible, options.Visible, true) == true,
            Knocked        = pick(CHECKS.Knocked, options.Knocked, true) == true,
            ForceField     = pick(CHECKS.ForceField, options.ForceField, false) == true,
            SelfKnocked    = pick(CHECKS.SelfKnocked, options.SelfKnocked, false) == true,
            OffScreen      = pick(TARGET["Off Screen Targeting"], options.OffScreen, false) == true,
        }
        local holdKey = resolveKey(settings.HoldKey)

        local destroyed, held, toggled = false, false, false
        local lastScan, lastRoll, rollPass = -math.huge, -math.huge, true
        local cachedTarget
        local leases, connections = {}, {}
        local calls, redirects, lastShape, lastError = 0, 0, "waiting for native getAim", nil

        local function connect(signal, callback)
            connections[#connections + 1] = signal:Connect(callback)
        end

        local function cursor(camera)
            if Input.MouseBehavior == Enum.MouseBehavior.LockCenter then
                return camera.ViewportSize * 0.5
            end
            return Input:GetMouseLocation()
        end

        local function knocked(character)
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then return true end
            if humanoid.PlatformStand then return true end
            if character:GetAttribute("Knocked") == true then return true end
            return character:FindFirstChild("Knocked") ~= nil
        end

        local function reloading(character)
            local tool = character:FindFirstChildOfClass("Tool")
            if not tool then return false end
            if tool:GetAttribute("Reloading") == true then return true end
            if character:GetAttribute("Reloading") == true then return true end
            local flag = tool:FindFirstChild("Reloading")
            return (flag and flag:IsA("BoolValue") and flag.Value) or false
        end

        local function isLimb(part)
            return part:IsA("BasePart")
                and not part:GetAttribute("vest_hb")
                and not part:FindFirstAncestorOfClass("Tool")
                and not part:FindFirstAncestorOfClass("Accessory")
        end

        local function visible(camera, point, character)
            if not settings.WallCheck then return true end
            local own = player.Character
            local params = RaycastParams.new()
            params.FilterType = Enum.RaycastFilterType.Exclude
            params.FilterDescendantsInstances = own and { own } or {}
            params.IgnoreWater = true
            local origin = camera.CFrame.Position
            local hit = Workspace:Raycast(origin, point - origin, params)
            return hit == nil or hit.Instance:IsDescendantOf(character)
        end

        -- closest point on a part's box (optionally scaled) to a ray, in world space
        local function closestOnBox(part, scale, origin, direction)
            local cf = part.CFrame
            local half = (part.Size * scale) * 0.5
            local inv = cf:Inverse()
            local localOrigin = inv * origin
            local localDir = (inv * (origin + direction)) - localOrigin

            local center = Vector3.zero
            local denom = localDir:Dot(localDir)
            local t = 0
            if denom > 1e-6 then
                t = math.max((center - localOrigin):Dot(localDir) / denom, 0)
            end
            local onRay = localOrigin + localDir * t
            local clamped = Vector3.new(
                math.clamp(onRay.X, -half.X, half.X),
                math.clamp(onRay.Y, -half.Y, half.Y),
                math.clamp(onRay.Z, -half.Z, half.Z)
            )
            return cf * clamped
        end

        local function rayDistance(point, origin, direction)
            local rel = point - origin
            local t = math.max(rel:Dot(direction), 0)
            return (rel - direction * t).Magnitude
        end

        local function fovUnit(camera)
            if settings.FOVUnit == "Pixels" then return settings.FOVScale end
            return (math.min(camera.ViewportSize.X, camera.ViewportSize.Y) / 100) * settings.FOVScale
        end

        local function inFOV(screen, mouse, camera)
            if not settings.FOVEnabled then return true end
            local unit = fovUnit(camera)
            return math.abs(screen.X - mouse.X) <= settings.FOVX * unit
                and math.abs(screen.Y - mouse.Y) <= settings.FOVY * unit
        end

        local function aimFor(character, root, origin, direction)
            local point, chosen, best

            local function consider(part)
                if not part or not part:IsA("BasePart") then return end
                local scale = (settings.ClosestPoint and settings.ClosestMode == "Scaled")
                    and settings.ClosestScale or 1
                local candidate = settings.ClosestPoint
                    and closestOnBox(part, scale, origin, direction)
                    or part.Position
                local score = rayDistance(candidate, origin, direction)
                if not best or score < best then
                    best, chosen, point = score, part, candidate
                end
            end

            if settings.AimPart == "Head" then
                consider(character:FindFirstChild("Head"))
            elseif settings.AimPart == "HumanoidRootPart" then
                consider(character:FindFirstChild("HumanoidRootPart"))
            else
                for _, part in ipairs(character:GetDescendants()) do
                    if isLimb(part) then consider(part) end
                end
            end

            if not point then return nil end

            if settings.Prediction then
                local values = settings.PredictionVal
                local velocity = root.AssemblyLinearVelocity
                if velocity and velocity.Magnitude < 500 then
                    point = point + velocity * Vector3.new(
                        tonumber(values[1]) or 0,
                        tonumber(values[2]) or 0,
                        tonumber(values[3]) or 0
                    )
                end
            end

            return chosen, point, best
        end

        local function stillValid(target)
            local character = target.character
            if not character or not character.Parent then return false end
            local humanoid = character:FindFirstChildOfClass("Humanoid")
            if not humanoid or humanoid.Health <= 0 then return false end
            if not target.part or not target.part.Parent then return false end
            return true
        end

        local function choose()
            local now = os.clock()
            if cachedTarget and now - lastScan < settings.ScanInterval then
                if stillValid(cachedTarget) then return cachedTarget end
                cachedTarget = nil
            end
            lastScan, cachedTarget = now, nil

            local camera = Workspace.CurrentCamera
            if not camera then return nil end

            local own = player.Character
            if settings.SelfKnocked and own and knocked(own) then return nil end

            local tool = own and own:FindFirstChildOfClass("Tool")
            if tool and reloading(own) then return nil end

            local origin = camera.CFrame.Position
            local mouse = cursor(camera)
            local ray = camera:ViewportPointToRay(mouse.X, mouse.Y)

            local bestTarget, bestScore

            for _, other in ipairs(Players:GetPlayers()) do
                if other ~= player then
                    local character = other.Character
                    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
                    if character and humanoid and humanoid.Health > 0 then
                        local allowed = true
                        if settings.TeamCheck and player.Team and other.Team == player.Team then allowed = false end
                        if allowed and settings.Knocked and knocked(character) then allowed = false end
                        if allowed and settings.ForceField and character:FindFirstChildOfClass("ForceField") then allowed = false end
                        local root = character.PrimaryPart or character:FindFirstChild("HumanoidRootPart")
                        if allowed and root and (root.Position - origin).Magnitude <= settings.MaxDistance then
                            local part, point, score = aimFor(character, root, ray.Origin, ray.Direction)
                            if part then
                                local screen, onScreen = camera:WorldToViewportPoint(point)
                                local screenOK = settings.OffScreen or not settings.Visible or onScreen
                                if screen.Z > 0 and screenOK and inFOV(screen, mouse, camera)
                                    and (not bestScore or score < bestScore)
                                    and visible(camera, point, character)
                                then
                                    bestScore = score
                                    bestTarget = { player = other, character = character, part = part, point = point }
                                end
                            end
                        end
                    end
                end
            end

            if not bestTarget then return nil end

            if now - lastRoll >= 0.05 then
                lastRoll = now
                rollPass = settings.Hitchance >= 100
                    or (settings.Hitchance > 0 and math.random() * 100 <= settings.Hitchance)
            end
            if not rollPass then return nil end

            cachedTarget = bestTarget
            return cachedTarget
        end

        local function redirected(value, target, camera, arguments)
            local kind = typeof(value)
            lastShape = kind
            if kind == "Vector3" then
                local origin = arguments and arguments[1]
                if typeof(origin) == "Vector3" and value.Magnitude <= 2 then
                    local direction = target.point - origin
                    if direction.Magnitude > 0 then
                        lastShape = "Vector3 direction"
                        return direction.Unit * math.max(value.Magnitude, 1), true
                    end
                end
                lastShape = "Vector3 world point"
                return target.point, true
            end
            if kind == "Vector2" then
                local point = camera:WorldToViewportPoint(target.point)
                return Vector2.new(point.X, point.Y), true
            end
            if kind == "CFrame" then
                return CFrame.lookAt(value.Position, target.point), true
            end
            if kind == "Ray" then
                local length = value.Direction.Magnitude
                local direction = target.point - value.Origin
                if direction.Magnitude <= 0 then return value, false end
                return Ray.new(value.Origin, direction.Unit * math.max(length, direction.Magnitude)), true
            end
            return value, false
        end

        local function active()
            if destroyed or not settings.Enabled then return false end
            if settings.Method == "Always" then return true end
            if settings.Method == "Toggle" then return toggled end
            return held
        end

        local function install(exported, key, path)
            local original = rawget(exported, key)
            if type(original) ~= "function" then return false end
            local wrapper
            wrapper = function(...)
                local arguments = table.pack(...)
                local packed = table.pack(original(table.unpack(arguments, 1, arguments.n)))
                calls += 1
                local camera = Workspace.CurrentCamera
                local target = active() and camera and choose() or nil
                if target then
                    for index = 1, packed.n do
                        local replacement, changed = redirected(packed[index], target, camera, arguments)
                        if changed then
                            packed[index] = replacement
                            redirects += 1
                            break
                        end
                    end
                end
                return table.unpack(packed, 1, packed.n)
            end
            local ok, err = pcall(function() rawset(exported, key, wrapper) end)
            if not ok or rawget(exported, key) ~= wrapper then
                lastError = path .. "." .. tostring(key) .. ": " .. tostring(err or "not writable")
                return false
            end
            leases[#leases + 1] = { owner = exported, key = key, original = original, wrapper = wrapper, path = path }
            return true
        end

        local function modulePath(module)
            local ok, path = pcall(function() return module:GetFullName() end)
            return ok and path or tostring(module.Name)
        end

        for _, module in ipairs(getloadedmodules()) do
            local name = string.lower(tostring(module.Name))
            if name:find("gun", 1, true) or name:find("weapon", 1, true) or name:find("aim", 1, true) then
                local ok, exported = pcall(require, module)
                if ok and type(exported) == "table" then
                    for key, value in pairs(exported) do
                        local normalized = type(key) == "string" and string.lower(key) or ""
                        if type(value) == "function" and (normalized == "getaim" or normalized == "getaimposition"
                            or normalized == "getaimpoint" or normalized == "aim") then
                            install(exported, key, modulePath(module))
                        end
                    end
                end
            end
        end
        assert(#leases > 0, "No writable getAim-like export was found in already-loaded gun modules")

        local function matches(input)
            return input.KeyCode == holdKey or input.UserInputType == holdKey
        end

        connect(Input.InputBegan, function(input, processed)
            if not matches(input) then return end
            if settings.Method == "Toggle" then
                if not processed then toggled = not toggled; cachedTarget = nil end
            elseif not processed then
                held = true
            end
        end)
        connect(Input.InputEnded, function(input)
            if not matches(input) then return end
            held = false
            cachedTarget = nil
        end)
        connect(Input.WindowFocusReleased, function() held = false; cachedTarget = nil end)

        local api = {}
        function api:Set(name, value)
            assert(settings[name] ~= nil, "Unknown setting " .. tostring(name))
            settings[name] = value
            if name == "HoldKey" then holdKey = resolveKey(value) end
            if name == "Hitchance" then settings.Hitchance = math.clamp(tonumber(value) or 100, 0, 100) end
            cachedTarget = nil
        end
        function api:Status()
            local paths = {}
            for _, lease in ipairs(leases) do paths[#paths + 1] = lease.path .. "." .. tostring(lease.key) end
            return {
                Active = not destroyed and settings.Enabled,
                Method = settings.Method,
                Hitchance = settings.Hitchance,
                FOV = settings.FOVEnabled and (settings.FOVX .. "/" .. settings.FOVY) or "off",
                AimPart = settings.AimPart,
                ClosestPoint = settings.ClosestPoint and (settings.ClosestMode .. " x" .. settings.ClosestScale) or false,
                Prediction = settings.Prediction,
                Calls = calls, Redirects = redirects,
                ReturnShape = lastShape, Hooks = paths,
                Target = cachedTarget and cachedTarget.player.Name or nil,
                Point = cachedTarget and tostring(cachedTarget.point) or nil,
                Error = lastError,
            }
        end
        function api:Destroy()
            if destroyed then return end
            destroyed = true
            for _, connection in ipairs(connections) do connection:Disconnect() end
            for _, lease in ipairs(leases) do
                pcall(function()
                    if rawget(lease.owner, lease.key) == lease.wrapper then rawset(lease.owner, lease.key, lease.original) end
                end)
            end
            table.clear(leases)
            cachedTarget = nil
        end
        return api
    end

end)()

