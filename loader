local function applyGunMods(tool)
    if not tool then return end

    local misc = shared.vest["Misc"]
    if not misc then return end

    local spreadConfig = misc["Spread Modifications"]

    if not spreadConfig or not spreadConfig["Enabled"] then
        return
    end

    local weaponConfig = spreadConfig[tool.Name]
    if not weaponConfig then return end

    local normal = weaponConfig["Normal"]
    if not normal or not normal[1] then return end

    local minSpread = normal[1][1]
    local maxSpread = normal[1][2]

    local spreadValue = tool:FindFirstChild("Spread")

    if spreadValue and spreadValue:IsA("NumberValue") then
        spreadValue.Value = math.random(
            math.min(minSpread, maxSpread),
            math.max(minSpread, maxSpread)
        )
    end
end

local WALL_DISTANCE = 3.5
local CLIMB_SPEED = 48
local WALL_PUSH = 2
local JUMP_DEBOUNCE = 0.12

local lastJump = 0

local function getWall(character, root)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}

    local directions = {
        root.CFrame.LookVector,
        -root.CFrame.LookVector,
        root.CFrame.RightVector,
        -root.CFrame.RightVector
    }

    for _, direction in ipairs(directions) do
        local result = Workspace:Raycast(
            root.Position,
            direction * WALL_DISTANCE,
            params
        )

        if result and math.abs(result.Normal.Y) < 0.3 then
            return result
        end
    end

    return nil
end

local function wallJump()
    local movement = shared.vest["Misc"]

    if not movement["Wall Jump"]["Enabled"] then return end
    if not movement["No Jump Cooldown"]["Enabled"] then return end

    if os.clock() - lastJump < JUMP_DEBOUNCE then return end

    local character = LocalPlayer.Character
    if not character then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root then return end
    if humanoid.FloorMaterial ~= Enum.Material.Air then return end

    local wall = getWall(character, root)
    if not wall then return end

    lastJump = os.clock()

    local velocity = root.AssemblyLinearVelocity

    root.AssemblyLinearVelocity = Vector3.new(
        velocity.X - wall.Normal.X * WALL_PUSH,
        CLIMB_SPEED,
        velocity.Z - wall.Normal.Z * WALL_PUSH
    )

    humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
end

UserInputService.JumpRequest:Connect(wallJump)

local function setupNoJumpCooldown(character)
    local humanoid = character:WaitForChild("Humanoid")

    local movement = shared.vest["Misc"]
    local config = movement["No Jump Cooldown"]

    if not config["Enabled"] then return end

    humanoid:GetAttributeChangedSignal("_LastJumpPower"):Connect(function()
        if not config["Enabled"] then return end

        local lastPower = humanoid:GetAttribute("_LastJumpPower")

        if humanoid.JumpPower == 0 and lastPower then
            humanoid.JumpPower = lastPower
        end
    end)

    humanoid:GetPropertyChangedSignal("JumpPower"):Connect(function()
        if not config["Enabled"] then return end

        if humanoid.JumpPower > 0 then
            humanoid:SetAttribute("_LastJumpPower", humanoid.JumpPower)

        elseif humanoid.JumpPower == 0 then
            humanoid.JumpPower =
                humanoid:GetAttribute("_LastJumpPower") or 50
        end
    end)
end

if LocalPlayer.Character then
    task.spawn(setupNoJumpCooldown, LocalPlayer.Character)
end

LocalPlayer.CharacterAdded:Connect(function(character)
    task.spawn(setupNoJumpCooldown, character)
end)

