local function knocked(char)
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return true end
	if hum.PlatformStand then return true end
	if char:GetAttribute("Knocked") == true then return true end
	return char:FindFirstChild("Knocked") ~= nil
end

local function reloading(char)
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then return false end
	if tool:GetAttribute("Reloading") == true then return true end
	if char:GetAttribute("Reloading") == true then return true end
	local v = tool:FindFirstChild("Reloading")
	return (v and v:IsA("BoolValue") and v.Value) or false
end

local function weaponAllowed(char)
	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then return false end
	if CHECKS.Knife and tool.Name:lower():find("knife") then return true end
	local sel = TB["Selected Weapons"]
	if not sel or not sel.Enabled then return true end
	local tagged = "[" .. tool.Name .. "]"
	for _, w in ipairs(sel.Weapons) do
		if w == tagged then return true end
	end
	return false
end

local function limbOK(name)
	local want = TB.HitPart
	if want == nil or want == "ClosestPart" then return true end
	if want == "Head" then return name == "Head" end
	if want == "HumanoidRootPart" or want == "HuamnoidRootPart" then return name == "HumanoidRootPart" end
	return true
end

local function isLimb(part)
	return part:IsA("BasePart")
		and not part:GetAttribute("vest_hb")
		and not part:FindFirstAncestorOfClass("Tool")
		and not part:FindFirstAncestorOfClass("Accessory")
end

local function resolvePart(char)
	local want = TB.HitPart
	if want == "Head" then return char:FindFirstChild("Head") end
	if want == "HumanoidRootPart" or want == "HuamnoidRootPart" then return char:FindFirstChild("HumanoidRootPart") end
	local best, bestD
	local origin = Cam.CFrame.Position
	for _, p in ipairs(char:GetDescendants()) do
		if isLimb(p) then
			local d = (p.Position - origin).Magnitude
			if not bestD or d < bestD then best, bestD = p, d end
		end
	end
	return best
end

local function fovUnit()
	if LOCAL.FOVUnit == "Pixels" then return LOCAL.FOVScale end
	return (math.min(Cam.ViewportSize.X, Cam.ViewportSize.Y) / 100) * LOCAL.FOVScale
end

local function inFov(screen, mouse, fov, unit)
	return math.abs(screen.X - mouse.X) <= fov.X * unit
		and math.abs(screen.Y - mouse.Y) <= fov.Y * unit
end

local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true

local function canSee(selfChar, targetChar, point)
	rp.FilterDescendantsInstances = { selfChar, folder, LP.Character }
	local origin = Cam.CFrame.Position
	local res = workspace:Raycast(origin, point - origin, rp)
	return res == nil or res.Instance:IsDescendantOf(targetChar)
end

local State = { LastShot = 0 }

local function pickTarget(selfChar, maxDist, fov, unit)
	local origin = Cam.CFrame.Position
	local mouse = UIS:GetMouseLocation()
	local bestPlr, bestDist

	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= LP then
			local pchar = plr.Character
			local phum = pchar and pchar:FindFirstChildOfClass("Humanoid")
			local root = pchar and (pchar.PrimaryPart or pchar:FindFirstChild("HumanoidRootPart"))
			if pchar and phum and phum.Health > 0 and root
				and not (CHECKS.Knocked and knocked(pchar))
				and not (CHECKS.ForceField and pchar:FindFirstChildOfClass("ForceField"))
				and weaponAllowed(pchar)
			then
				local part = resolvePart(pchar)
				if part and limbOK(part.Name) then
					local d = (root.Position - origin).Magnitude
					if d <= maxDist then
						local pos, onScreen = Cam:WorldToViewportPoint(part.Position)
						if pos.Z > 0
							and (not CHECKS.Visible or onScreen or OFF_SCREEN)
							and inFov(pos, mouse, fov, unit)
							and (not CHECKS.WallCheck or canSee(selfChar, pchar, part.Position))
							and (not bestDist or d < bestDist)
						then
							bestPlr, bestDist = plr, d
						end
					end
				end
			end
		end
	end
	return bestPlr
end

table.insert(CONNS, RunService.RenderStepped:Connect(function()
	Cam = workspace.CurrentCamera or Cam

	if not TB.Enabled then return end

	local char = LP.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not char or not hum or hum.Health <= 0 then return end

	local active
	if TB.Method == "Always" then
		active = true
	elseif TB.Method == "Toggle" then
		active = toggled
	else
		active = down[KEY] == true
	end
	if not active then return end

	if CHECKS.SelfKnocked and knocked(char) then return end
	if CHECKS.Reloading and reloading(char) then return end
	if UIS:GetFocusedTextBox() then return end

	local tool = char:FindFirstChildOfClass("Tool")
	if not tool then return end

	local now = os.clock()
	if now - State.LastShot < LOCAL.ClickCooldown then return end

	local dist = TB["Distance Check"]
	local maxDist = (dist and dist.Enabled) and (tonumber(dist["Max Distance"]) or math.huge) or math.huge
	local fov = TB.FOV or { X = 100, Y = 100 }

	local target = pickTarget(char, maxDist, fov, fovUnit())
	if not target then return end

	State.LastShot = now

	local d = TB.Delay or {}
	local s = tonumber(d.Start) or 0.02
	local e = tonumber(d.End) or s
	if e < s then e = s end

	task.delay(s + math.random() * (e - s), tapShot)
end))

