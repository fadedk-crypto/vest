			local head = char and char:FindFirstChild("Head")
			local root = char and (char.PrimaryPart or char:FindFirstChild("HumanoidRootPart"))
			local obj = getObj(plr)

			local draw = char ~= nil and hum ~= nil and head ~= nil and root ~= nil and hum.Health > 0
			local dist = draw and (root.Position - Cam.CFrame.Position).Magnitude or math.huge
			if draw and dist > ESPLOCAL.MaxDistance then draw = false end

			local height, width, midX, left, topY, color

			if draw then
				local topPoint = head.Position + Vector3.new(0, head.Size.Y * 0.5 + 0.4, 0)
				local bottomPoint = root.Position - Vector3.new(0, 3, 0)
				local topScreen, topOn = Cam:WorldToViewportPoint(topPoint)
				local bottomScreen, bottomOn = Cam:WorldToViewportPoint(bottomPoint)

				if not (topOn and bottomOn and topScreen.Z > 0 and bottomScreen.Z > 0) then
					draw = false
				else
					height = math.abs(bottomScreen.Y - topScreen.Y)
					width = math.max(height * 0.45, 4)
					midX = (topScreen.X + bottomScreen.X) * 0.5
					left = midX - width * 0.5
					topY = math.min(topScreen.Y, bottomScreen.Y)

					color = (plr == target) and targetColor or baseColor
					if knocked(char) then
						color = color:Lerp(Color3.new(0.55, 0.55, 0.55), 0.6)
					end
					if not espClear(own, char, root.Position) then
						if ESPLOCAL.WallDim then
							color = color:Lerp(Color3.new(0, 0, 0), 0.55)
						else
							draw = false
						end
					end
				end
			end

			if not draw then
				for _, d in pairs(obj) do pcall(function() d.Visible = false end) end
			else
				local yTop, yBottom = topY, topY + height
				local xHealth = left - barW - 3
				local xArmor = xHealth - armorW - 2

				local hpFrac = (hum.MaxHealth > 0 and math.clamp(hum.Health / hum.MaxHealth, 0, 1)) or 0
				local fillH = height * hpFrac
				local hColor = healthEmpty:Lerp(healthFull, hpFrac)
				if plr == target then hColor = hColor:Lerp(targetColor, 0.35) end

				obj.healthBg.Visible = healthOn
				if healthOn then
					obj.healthBg.Color = barBg
					obj.healthBg.Position = Vector2.new(xHealth, yTop)
					obj.healthBg.Size = Vector2.new(barW, height)
				end

				obj.health.Visible = healthOn and fillH > 0.5
				if obj.health.Visible then
					obj.health.Color = hColor
					obj.health.Position = Vector2.new(xHealth, anchorBottom and (yBottom - fillH) or yTop)
					obj.health.Size = Vector2.new(barW, fillH)
				end

				local armorRaw = char:GetAttribute("Armor")
				if type(armorRaw) ~= "number" then
					local av = char:FindFirstChild("Armor")
					if av and av:IsA("ValueBase") then armorRaw = av.Value end
				end
				local armorMax = char:GetAttribute("MaxArmor")
				if type(armorMax) ~= "number" or armorMax <= 0 then armorMax = 100 end
				local armorFrac = (type(armorRaw) == "number" and armorRaw > 0)
					and math.clamp(armorRaw / armorMax, 0, 1) or 0
				local showArmor = armorOn and armorFrac > 0
				local aFill = height * armorFrac

				obj.armorBg.Visible = showArmor
				obj.armor.Visible = showArmor
				if showArmor then
					obj.armorBg.Color = armorBgColor
					obj.armorBg.Position = Vector2.new(xArmor, yTop)
					obj.armorBg.Size = Vector2.new(armorW, height)

					obj.armor.Color = armorColor
					obj.armor.Position = Vector2.new(xArmor, anchorBottom and (yBottom - aFill) or yTop)
					obj.armor.Size = Vector2.new(armorW, aFill)
				end

				local scale = math.clamp(140 / math.max(dist, 25), 0.5, 2)
				local size = math.max(math.floor(fontSize * scale + 0.5), 8)
				obj.name.Visible = showName
				if showName then
					obj.name.Text = (ncfg.Type == "Name") and plr.Name or plr.DisplayName
					obj.name.Font = font
					obj.name.Size = size
					obj.name.Color = color
					obj.name.Position = onTop
						and Vector2.new(midX, topY - size - 6)
						or Vector2.new(midX, topY + height + 6)
				end
			end
		end
	end

	for plr in pairs(ESP.Objects) do
		if not seen[plr] then destroyObj(plr) end
	end
end))
