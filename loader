local function espClear(own, char, point)
	local origin = Cam.CFrame.Position
	espParams.FilterDescendantsInstances = { own, folder, LP.Character }
	local res = workspace:Raycast(origin, point - origin, espParams)
	return res == nil or res.Instance:IsDescendantOf(char)
end

local function espTarget()
	local mode = (CFG.Targeting and CFG.Targeting["Enabled"]) or "Manual"

	if mode == "Automatic" then
		local bestD, bestPlr
		local mouse = UIS:GetMouseLocation()
		for _, other in ipairs(Players:GetPlayers()) do
			if other ~= LP then
				local c = other.Character
				local h = c and c:FindFirstChildOfClass("Humanoid")
				local head = c and c:FindFirstChild("Head")
				if head and h and h.Health > 0 then
					local pos, on = Cam:WorldToViewportPoint(head.Position)
					if pos.Z > 0 and (on or OFF_SCREEN) then
						local d = (Vector2.new(pos.X, pos.Y) - mouse).Magnitude
						if not bestD or d < bestD then bestD, bestPlr = d, other end
					end
				end
			end
		end
		return bestPlr
	end

	if okAim and aimApi then
		local ok, st = pcall(function() return aimApi:Status() end)
		if ok and st and st.Target then
			local found = Players:FindFirstChild(st.Target)
			if found then return found end
		end
	end

	local t = Mouse.Target
	if t then
		if boxOwner[t] then return boxOwner[t] end
		local model = t:FindFirstAncestorOfClass("Model")
		local p = model and Players:GetPlayerFromCharacter(model)
		if p then return p end
	end
	return nil
end

